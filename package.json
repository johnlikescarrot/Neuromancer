{
  "name": "neuromancer-bilingual-edition",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Definitive TypeScript/Astryx-token PDF builder for the Neuromancer English-Vietnamese bilingual C1/C2 edition",
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/build.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "latest",
    "@astryxdesign/theme-neutral": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
